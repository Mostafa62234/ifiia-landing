# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/platform/headers/

# Font files use content-stable names (fonts/amiri-400-normal-arabic.woff2).
# Immutable is safe: names only change if the upstream font version changes,
# which produces a new filename.
/fonts/*
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

# Rebuilt during launch iteration - keep the window short.
/fonts.css
  Cache-Control: public, max-age=600, must-revalidate

/styles.css
  Cache-Control: public, max-age=600, must-revalidate

# Rewritten on each launch iteration - keep the window short.
/auth.js
  Cache-Control: public, max-age=600, must-revalidate

/legal.js
  Cache-Control: public, max-age=600, must-revalidate

# Third-party vendor bundle, replaced only on deliberate upgrades.
/vendor/*
  Content-Type: application/javascript
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=600, must-revalidate

# HTML must always be revalidated so new deploys are picked up immediately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
